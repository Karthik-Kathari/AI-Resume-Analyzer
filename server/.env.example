# Server Environment Variables
# Copy this file to .env and fill in your values — NEVER commit .env

PORT=5000
NODE_ENV=development

# MongoDB Atlas — free tier connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/resume-analyzer?retryWrites=true&w=majority

# JWT Secrets — min 32 chars each
JWT_ACCESS_SECRET=your_access_token_secret_min_32_chars
JWT_REFRESH_SECRET=your_refresh_token_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Zero-Cost Architecture (Default: false, ₹0 cost)
# Core application runs 100% on local rule-based matching engine without any external APIs.
ENABLE_AI_ENHANCEMENT=false
GEMINI_API_KEY=

# Email / SMTP Configuration (Optional)
# If left blank, OTPs will be printed to server logs for testing and zero-cost local dev.
# For free production emails, you can use Gmail App Password or free SMTP (Brevo / SendGrid / Ethereal).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM="ResumeIQ <no-reply@resumeiq.com>"
